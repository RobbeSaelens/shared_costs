<button{{ attributes.addClass('theme-toggle').setAttribute('type', 'button').setAttribute('aria-pressed', 'false').setAttribute('data-theme-toggle', '') }}>
  {{ include('stal_manager_theme:icon', {name: 'moon', attributes: create_attribute({'class': ['theme-toggle__moon']})}, with_context = false) }}
  {{ include('stal_manager_theme:icon', {name: 'sun', attributes: create_attribute({'class': ['theme-toggle__sun']})}, with_context = false) }}
  <span class="nav-label">{{ 'Dark mode'|t }}</span>
</button>
