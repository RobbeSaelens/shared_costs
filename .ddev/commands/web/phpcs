#!/usr/bin/env bash

## Description: Run phpcs on the repository with its phpcs.xml.dist
## Usage: phpcs [flags] [args]
## Example: "ddev phpcs" or "ddev phpcs src/Hook/SharedCostsHooks.php"
## ExecRaw: true

# Not the ddev-drupal-contrib version: that one runs on the module's copy in
# web/modules/custom, which phpcs.xml.dist excludes (with web/), so it would
# check nothing. This runs from the repository root.
set -eu -o pipefail

cd "$DDEV_APPROOT"
vendor/bin/phpcs -s --report-full --report-summary --report-source --standard=phpcs.xml.dist "$@"
