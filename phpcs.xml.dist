<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="shared_costs">
  <description>Drupal coding standards for the shared_costs module.</description>

  <file>.</file>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,txt,md,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <!-- Built by ddev-drupal-contrib, not part of the project. -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/web/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/.ddev/*</exclude-pattern>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
